# ================================
# Focus FTP — Environment Variables
# ================================
# Copy this file to `.env` and adjust. NEVER commit the real `.env`.

# --- PostgreSQL (API / server) ---
# Used by `server/` only. Example matches docker-compose.yml defaults.
# DATABASE_URL=postgres://focus_ftp:focus_ftp_local@localhost:5432/focus_ftp

# --- Frontend (Vite) ---
# Optional dev-only seed for legacy tests (localAuth); the app uses server auth in normal dev.
# VITE_LOCAL_AUTH_EMAIL=you@example.com
# VITE_LOCAL_AUTH_PASSWORD=your-local-password
