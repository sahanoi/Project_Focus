# ================================
# Focus FTP — Environment Variables
# ================================
# Copy this file to .env and adjust as needed.
# NEVER commit the actual .env file.

# Data and auth are stored in the browser (localStorage). No cloud backend in this phase.

# Optional: pre-seed one login in dev (plain text in bundle — dev only)
# VITE_LOCAL_AUTH_EMAIL=you@example.com
# VITE_LOCAL_AUTH_PASSWORD=your-local-password
