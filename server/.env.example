# Copy to `server/.env` or set in shell before `npm run dev`.
# Dedicated app role (not the postgres superuser). Change password for shared machines.
DATABASE_URL=postgres://focus_ftp:focus_ftp_local@localhost:5432/focus_ftp
PORT=3001
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

